{
  // Cadena de conexión a SQL Server (autenticación de Windows, base local).
  "ConnectionStrings": {
    "ConexionPrincipal": "Server=localhost;Database=AutenticacionSeguraDB;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // Minutos de vigencia de la cookie de autenticación.
  // 10080 = 7 días. Solo afecta a la cookie persistente ("Recordarme").
  "Autenticacion": {
    "VigenciaCookieMinutos": 10080,
    // Minutos que dura el enlace de "Olvidé mi contraseña" antes de vencer.
    "VigenciaTokenRecuperacionMinutos": 30
  },

  // Configuración NO secreta del servidor de correo (SMTP de Gmail).
  // Smtp:Usuario y Smtp:Clave NO están aquí: viven en User Secrets,
  // fuera del repositorio, y .NET los une a esta misma sección.
  "Smtp": {
    "Servidor": "smtp.gmail.com",
    "Puerto": 587,
    "UsarStartTls": true,
    "NombreRemitente": "AutenticacionSegura"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}