{
  // Cadenas de conexión de la aplicación.
  // "ConexionPrincipal" es el nombre con el que Program.cs la busca.
  "ConnectionStrings": {
    // Server=localhost                 -> SQL Server instalado en este equipo
    // Database=AutenticacionSeguraDB   -> base que se crea con la migración
    // Trusted_Connection=True          -> autenticación de Windows: NO lleva
    //                                     usuario ni contraseña, así que no hay
    //                                     secretos en el repositorio
    // TrustServerCertificate=True      -> acepta el certificado local de SQL Server
    //                                     (solo para desarrollo en este equipo)
    "ConexionPrincipal": "Server=localhost;Database=AutenticacionSeguraDB;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // Configuración de la cookie de autenticación (no es un secreto).
  "Autenticacion": {
    // Minutos que dura la cookie de autenticación. 10080 = 7 días.
    // Para probar "Recordarme" se puede bajar temporalmente (por ejemplo, a 2).
    "VigenciaCookieMinutos": 10080
  },

  // Nivel de detalle de los mensajes de registro (logs)
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Hosts permitidos para las peticiones (* = todos, útil en desarrollo)
  "AllowedHosts": "*"
}