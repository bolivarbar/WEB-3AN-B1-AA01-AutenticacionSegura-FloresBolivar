<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutenticacionSegura.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutenticacionSegura.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AutenticacionSegura.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @* El menú cambia según haya o no una sesión iniciada.
                           User.Identity.IsAuthenticated es true cuando la cookie de autenticación es válida.
                           OJO: ocultar enlaces es solo comodidad visual; la seguridad real está en
                           [Authorize] en el servidor. *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="AreaPersonal">Área personal</a>
                            </li>
                            @* Enlace al perfil (PerfilController, protegido con [Authorize]). *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Perfil" asp-action="Index">Mi perfil</a>
                            </li>
                            @* Solo los administradores ven este enlace. OJO: esto es solo comodidad visual;
                               la protección real es [Authorize(Roles = Administrador)] en el servidor. *@
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Administracion" asp-action="Index">Administración</a>
                                </li>
                            }
                            <li class="nav-item">
                                @* Cerrar sesión es un formulario POST: el form tag helper agrega el token
                                   antiforgery, que CuentaController.Logout verifica. *@
                                <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Cerrar sesión (@User.Identity.Name)</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* Mensaje temporal (TempData) que se muestra una sola vez tras una acción exitosa. *@
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success">@mensaje</div>
            }
            @* Mensaje de error (TempData["Error"]) que se muestra una sola vez en rojo. *@
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &#169; 2026 - AutenticacionSegura.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>