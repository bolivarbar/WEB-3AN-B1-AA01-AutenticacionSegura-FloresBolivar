@* Formulario "Olvidé mi contraseña" (OlvideClave): pide el correo y envía el enlace. *@
@model AutenticacionSegura.Web.Models.OlvideClaveViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<h1>Recuperar contraseña</h1>
<p>Escriba el correo de su cuenta. Si está registrado, le enviaremos un enlace para crear una nueva contraseña.</p>

<div class="row">
    <div class="col-md-5">
        @* method="post": el tag helper agrega solo el token antifalsificación. *@
        <form asp-controller="Recuperacion" asp-action="OlvideClave" method="post">
            @* Errores generales (no ligados a un campo). *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autocomplete="email" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
        </form>

        <p class="mt-3 text-center">
            <a asp-controller="Cuenta" asp-action="Login">Volver a iniciar sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}