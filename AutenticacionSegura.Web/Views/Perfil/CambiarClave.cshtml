@* ============================================================
   VISTA: Perfil/CambiarClave  ->  FORMULARIO "CAMBIAR CONTRASEÑA"
   Pide la contraseña actual, la nueva y su confirmación.
   El servidor verifica la actual: si es incorrecta, NO se cambia nada.
   Los campos de contraseña nunca se devuelven rellenos a la página.
   ============================================================ *@
@model AutenticacionSegura.Web.Models.CambiarClaveViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h1>Cambiar contraseña</h1>
<p class="text-muted">Mínimo 8 caracteres, con mayúscula, minúscula, número y un símbolo.</p>

@* Formulario "Cambiar contraseña" (con token antifalsificación automático). *@
<form asp-action="CambiarClave" asp-controller="Perfil" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ClaveActual" class="form-label"></label>
        <input asp-for="ClaveActual" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="ClaveActual" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ClaveNueva" class="form-label"></label>
        <input asp-for="ClaveNueva" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ClaveNueva" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarClave" class="form-label"></label>
        <input asp-for="ConfirmarClave" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarClave" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al perfil</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}